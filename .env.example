# Copia este archivo como .env y llena tus claves. Nunca subas .env a GitHub.

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Apify (https://console.apify.com/account/integrations)
APIFY_TOKEN=

# Instagram API con Instagram Login (token de larga duración de tu cuenta de creador)
IG_ACCESS_TOKEN=

# YouTube Data API v3 (opcional, Google Cloud Console)
YOUTUBE_API_KEY=

# Telegram (opcional, para recibir reportes en el móvil)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
